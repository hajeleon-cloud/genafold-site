---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import IndexList from "../../components/IndexList.astro";
import { site } from "../../config/site";

import heroDescription from "../../content/about-publications/hero-description.txt?raw";
import publications from "../../content/about-publications/publications.json";
---

<Layout title="Publications" description={`Peer-reviewed publications from the ${site.name} research team.`}>
  <PageHero
    eyebrow="ABOUT · PUBLICATIONS"
    title="Publications"
    description={heroDescription.trim()}
  />
  <section class="mx-auto max-w-6xl px-5 md:px-8 pb-20">
    <IndexList items={publications} />
  </section>
</Layout>
