---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import content from "../../content/services-pages/training.json";
---

<Layout title={content.pageTitle} description={content.metaDescription}>
  <PageHero
    eyebrow="SERVICES · TRAINING"
    title={content.heroTitle}
    description={content.heroDescription}
  />
  <section class="mx-auto max-w-6xl px-5 md:px-8 pb-20">
    <div class="grid md:grid-cols-3 gap-6">
      {content.formats.map((f) => (
        <div class="panel rounded-xl p-6">
          <h3 class="font-display text-lg mb-2">{f.title}</h3>
          <p class="text-fog text-sm leading-relaxed">{f.text}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
