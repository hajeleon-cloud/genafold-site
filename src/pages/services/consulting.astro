---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import content from "../../content/services-pages/consulting.json";
---

<Layout title={content.pageTitle} description={content.metaDescription}>
  <PageHero
    eyebrow="SERVICES · CONSULTING"
    title={content.heroTitle}
    description={content.heroDescription}
  />
  <section class="mx-auto max-w-6xl px-5 md:px-8 pb-20">
    <div class="grid md:grid-cols-3 gap-6">
      {content.steps.map((s, i) => (
        <div class="panel rounded-xl p-6">
          <span class="ref-tag mb-3 inline-block">STEP {i + 1}</span>
          <h3 class="font-display text-lg mb-2">{s.title}</h3>
          <p class="text-fog text-sm leading-relaxed">{s.text}</p>
        </div>
      ))}
    </div>
    <a href="/contact" class="inline-block mt-8 text-teal text-sm hover:underline">Book a scoping session →</a>
  </section>
</Layout>
