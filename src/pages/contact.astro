---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../config/site";

import heroDescription from "../content/contact/hero-description.txt?raw";
import tracksData from "../content/contact/tracks.json";

const tracks = tracksData.map((t) => ({
  ...t,
  email: site.email[t.emailKey as keyof typeof site.email],
}));
---

<Layout title="Contact" description={`Get in touch with ${site.name} for research, commercial, or support inquiries.`}>
  <PageHero
    eyebrow="CONTACT"
    title="Tell us what you're trying to discover."
    description={heroDescription.trim()}
  />

  <section class="mx-auto max-w-6xl px-5 md:px-8 pb-24">
    <div class="grid md:grid-cols-2 gap-10 items-start">
      <!-- Left column: contact tracks, stacked vertically -->
      <div class="flex flex-col gap-5">
        {tracks.map((t) => (
          <div id={t.id} class="panel rounded-xl p-6 scroll-mt-24">
            <h3 class="font-display text-lg mb-2">{t.title}</h3>
            <p class="text-fog text-sm leading-relaxed mb-4">{t.text}</p>
            <a href={`mailto:${t.email}`} class="text-teal text-sm hover:underline font-mono">{t.email}</a>
          </div>
        ))}
      </div>

      <!-- Right column: message form -->
      <div>
        <h2 class="font-display text-2xl font-semibold mb-2">Send a message</h2>
        <form action="https://formspree.io/f/mgogjgpo" method="POST" class="flex flex-col gap-5">
          <div>
            <label for="name" class="block text-xs font-mono uppercase tracking-wide text-fog mb-2">Name</label>
            <input id="name" name="name" type="text" required class="w-full rounded-lg bg-panel border border-line px-4 py-3 text-paper focus:border-teal outline-none" />
          </div>
          <div>
            <label for="email" class="block text-xs font-mono uppercase tracking-wide text-fog mb-2">Email</label>
            <input id="email" name="email" type="email" required class="w-full rounded-lg bg-panel border border-line px-4 py-3 text-paper focus:border-teal outline-none" />
          </div>
          <div>
            <label for="track" class="block text-xs font-mono uppercase tracking-wide text-fog mb-2">Inquiry type</label>
            <select id="track" name="track" class="w-full rounded-lg bg-panel border border-line px-4 py-3 text-paper focus:border-teal outline-none">
              <option>Research Collaboration</option>
              <option>Commercial Inquiry</option>
              <option>Support</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-xs font-mono uppercase tracking-wide text-fog mb-2">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-lg bg-panel border border-line px-4 py-3 text-paper focus:border-teal outline-none"></textarea>
          </div>
          <button type="submit" class="rounded-lg bg-teal text-ink font-medium px-5 py-3 hover:opacity-90 transition-opacity w-fit">
            Send message
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
