---
import Icon from "./icons/Icon.astro";

interface Props {
  title: string;
  description: string;
  href?: string;
  centered?: boolean;
  icon?: string;
}
const { title, description, href, centered = false, icon } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag href={href} class="group panel rounded-xl p-6 flex flex-col gap-3 hover:border-teal/50 transition-colors">
  {icon && (
    <div class:list={["w-fit rounded-lg bg-teal/10 p-2.5 text-teal", centered && "mx-auto"]}>
      <Icon name={icon} class="w-6 h-6" />
    </div>
  )}
  <h3 class:list={["font-display text-lg font-medium text-paper", centered && "text-center"]}>{title}</h3>
  <p class:list={["text-fog text-sm leading-relaxed", centered && "text-justify"]}>{description}</p>
  {href && (
    <span class="mt-2 text-sm text-teal opacity-0 group-hover:opacity-100 transition-opacity">
      Learn more →
    </span>
  )}
</Tag>
