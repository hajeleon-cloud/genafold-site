---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="mx-auto max-w-6xl px-5 md:px-8 pt-14 pb-10 fade-up text-center">
  <h1 class="text-4xl md:text-4xl font-semibold text-paper max-w-3xl mx-auto">{title}</h1>
  {description && <p class="mt-5 text-fog text-lg max-w-6xl mx-auto leading-relaxed text-justify">{description}</p>}
  <div class="tick-rule mt-10"></div>
</section>
