         <path d="M8 9.5h8M8 12.3h5" />`,

  graduation: `<path d="M2.5 9.5L12 5l9.5 4.5L12 14z" />
               <path d="M6.5 11.6v4.6c0 1.4 2.5 2.5 5.5 2.5s5.5-1.1 5.5-2.5v-4.6" />
               <path d="M21 9.5v5.5" />`,

  pipeline: `<rect x="2.5" y="9" width="5" height="6" rx="1" />
             <rect x="9.5" y="4" width="5" height="6" rx="1" />
