  molecule: `<circle cx="6" cy="7" r="2" />
             <circle cx="18" cy="7" r="2" />
             <circle cx="12" cy="17" r="2" />
             <circle cx="12" cy="9.5" r="1.6" />
             <path d="M7.6 8.1L10.6 9.5M16.4 8.1l-3 1.4M12 11.1v3.9" />`,

  shield: `<path d="M12 2.5l7.5 3v5.4c0 4.6-3.1 8.6-7.5 9.6-4.4-1-7.5-5-7.5-9.6V5.5z" />
           <path d="M8.7 12.2l2.1 2.1 4.3-4.3" />`,

  database: `<ellipse cx="12" cy="5.5" rx="7" ry="2.7" />
             <path d="M5 5.5v13c0 1.5 3.1 2.7 7 2.7s7-1.2 7-2.7v-13" />
